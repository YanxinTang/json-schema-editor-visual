{
  "name": "json-schema-editor-visual",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "rslib",
    "dev": "rslib --watch",
    "doc": "rspress dev",
    "doc:build": "rspress build",
    "doc:preview": "rspress preview",
    "format": "prettier --write .",
    "lint": "rslint",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{md,mdx,json,css,less,scss}": "prettier --experimental-cli --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "rslint --type-check",
      "prettier --experimental-cli --write"
    ]
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.0.0",
    "@rslib/core": "^0.21.3",
    "@rslint/core": "^0.5.0",
    "@rspress/core": "^2.0.9",
    "@rspress/plugin-api-docgen": "^2.0.9",
    "@rspress/plugin-preview": "^2.0.9",
    "@rstest/adapter-rslib": "^0.2.2",
    "@rstest/core": "^0.9.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "happy-dom": "^20.9.0",
    "nano-staged": "^1.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rsbuild-plugin-workspace-dev": "^0.1.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "private": true
}

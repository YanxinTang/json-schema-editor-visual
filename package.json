{
  "name": "json-schema-editor-visual",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "prepare": "simple-git-hooks",
    "format": "prettier --write .",
    "lint": "rslint"
  },
  "devDependencies": {
    "@rslint/core": "^0.5.2",
    "nano-staged": "^1.0.2",
    "playwright": "^1.49.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.8",
      "onFail": "download"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{md,mdx,json,css,less,scss}": "prettier --experimental-cli --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "rslint --type-check",
      "prettier --experimental-cli --write"
    ]
  }
}

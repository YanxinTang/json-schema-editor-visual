{
  "name": "@tyx1703/json-schema-editor-visual",
  "version": "1.0.1",
  "description": "A React component for visually editing JSON Schema",
  "type": "module",
  "license": "MIT",
  "author": "tyx1703",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanxinTang/json-schema-editor-visual.git"
  },
  "keywords": [
    "json-schema",
    "editor",
    "react",
    "visual",
    "antd"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.mjs",
    "build": "rslib",
    "build:test": "cross-env NODE_ENV='test' rslib",
    "dev": "rslib --watch",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "generate-schema": "^2.6.0",
    "monaco-editor": "^0.55.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.3",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rslib/core": "^0.21.5",
    "@rslint/core": "^0.5.3",
    "@rstest/adapter-rslib": "^0.10.1",
    "@rstest/browser": "^0.10.1",
    "@rstest/browser-react": "^0.10.1",
    "@rstest/core": "^0.10.1",
    "@rstest/coverage-istanbul": "^0.10.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.15",
    "antd": "6",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5 || ^6",
    "antd": "^5 || ^6",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
